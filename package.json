{
  "name": "btl-backend",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "pnpm --filter @codecash/api dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint --max-warnings 0 services",
    "format": "prettier --write services packages",
    "format:check": "prettier --check services packages",
    "test": "pnpm build && node tests/resource.test.mjs && node tests/postgres.test.mjs",
    "infra:up": "docker compose -f infra/compose.yaml up -d --wait",
    "infra:up:pg": "docker compose -f infra/compose.yaml --profile postgres up -d --wait postgres",
    "infra:down": "docker compose -f infra/compose.yaml down"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
