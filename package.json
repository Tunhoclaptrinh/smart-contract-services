{
  "name": "btl-backend",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "pnpm --filter @codecash/api dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint --max-warnings 0 services",
    "format": "prettier --write services",
    "format:check": "prettier --check services"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
