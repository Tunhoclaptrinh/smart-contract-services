# Local development. Copy to .env.
API_HOST=127.0.0.1
API_PORT=3000
WEB_ORIGIN=http://127.0.0.1:5173
# file (local, one process) | mongo (MONGO_URI, replica set) | postgres (DATABASE_URL)
STORAGE_DRIVER=file
DATA_DIR=.data
MONGO_URI=mongodb://127.0.0.1:27017/codecash?replicaSet=rs0
DATABASE_URL=postgres://codecash:codecash@127.0.0.1:5432/codecash
PG_SCHEMA=codecash
# Required in production; development generates an instance-local secret.
JWT_SECRET=
# Password of the seed accounts (default Passw0rd! in development).
SEED_PASSWORD=
# One-click demo sign-in (default on outside production).
DEMO_LOGIN=
# Self sign-up of a company with its account administrator (default on).
SIGNUP=
# Keys of the audit log (digests of personal values); default .data-trust next to the repo.
TRUST_DIR=
