              "pm.test(\"problem+json\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\"));",
              "pm.test(\"code AUTHENTICATION_REQUIRED\", () => pm.expect(pm.response.json().code).to.eql(\"AUTHENTICATION_REQUIRED\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Refresh — rotates the pair",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/refresh",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "refresh"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
              "const d = pm.response.json().data;",
              "pm.test(\"new refresh token\", () => pm.expect(d.refreshToken).to.not.eql(pm.collectionVariables.get(\"refreshToken\")));",
              "pm.collectionVariables.set(\"spentRefreshToken\", pm.collectionVariables.get(\"refreshToken\"));",
              "pm.collectionVariables.set(\"refreshToken\", d.refreshToken);",
              "pm.collectionVariables.set(\"accessToken\", d.accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Refresh — replay a spent token → 401, family revoked",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/refresh",
          "host": [
