      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"system administrator\", () => pm.expect(pm.response.json().data.role).to.eql(\"SYSTEM_ADMIN\"));"
            ]
          }
        }
      ]
    },
