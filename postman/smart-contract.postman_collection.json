    {
      "name": "22 List organizations (filters, facets)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/resources/organizations?limit=5&facets=kind&filters=%7B%22kind%22%3A%7B%22in%22%3A%5B%22BUYER%22%2C%22SUPPLIER%22%5D%7D%7D",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "resources",
            "organizations"
          ],
          "query": [
            {
              "key": "limit",
              "value": "5"
            },
            {
              "key": "facets",
              "value": "kind"
            },
            {
              "key": "filters",
              "value": "%7B%22kind%22%3A%7B%22in%22%3A%5B%22BUYER%22%2C%22SUPPLIER%22%5D%7D%7D"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"facets\", () => pm.expect(pm.response.json().data.facets.kind).to.be.an(\"array\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "23 Unknown route → 404 at the gateway",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/nowhere",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "nowhere"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 404\", () => pm.response.to.have.status(404));",
              "pm.test(\"code ROUTE_NOT_FOUND\", () => pm.expect(pm.response.json().code).to.eql(\"ROUTE_NOT_FOUND\"));"
            ]
          }
        }
      ]
    },
    {
