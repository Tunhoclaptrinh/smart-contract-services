    {
      "name": "11 Register a company with its administrator",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"organization\": {\n    \"name\": \"Công ty {{runId}}\",\n    \"code\": \"C{{runId}}\",\n    \"kind\": \"BUYER\"\n  },\n  \"admin\": {\n    \"displayName\": \"Quản trị {{runId}}\",\n    \"email\": \"admin{{runId}}@example.vn\",\n    \"password\": \"MotMatKhauDai2026!\"\n  }\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"runId\", String(Date.now()).slice(-8));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"orgAdminToken\", pm.response.json().data.accessToken);",
              "pm.test(\"ORG_ADMIN\", () => pm.expect(pm.response.json().data.user.role).to.eql(\"ORG_ADMIN\"));"
            ]
          }
        }
      ]
    },
